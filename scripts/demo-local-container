#!/bin/bash

name=$1; shift
port=$1; shift

#if [[ -z $port || $1 ]]; then
#   echo "Usage demo-local-container <name> <port>
#   exit 1
#fi

docker container ls | grep $name && ( docker kill "$name"; sleep 1;  docker rm "$name"; sleep 1)

docker run -d \
  --name "$name" \
  -p $port:$port \
  python:3-alpine \
  python -c "from http.server import HTTPServer, BaseHTTPRequestHandler; HTTPServer(('0.0.0.0',$port), type('Handler',(BaseHTTPRequestHandler,),{'do_GET':lambda self:(self.send_response(200),self.end_headers(),self.wfile.write(b'$name'))})).serve_forever()"

